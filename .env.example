# Copie para .env e ajuste. Linha comentada = opcional, com o default do codigo.
#
# Se a resposta de /ingest/create trouxe 192.168.x.x ou localhost, e porque as
# URLs publicas abaixo nao estao setadas: a API nunca adivinha o DNS — ela
# compoe rtmpUrl/playbackUrl/watchUrl a partir destas envs.

# -------- API --------
# Porta do servico aqui (no proxy/tunel o mundo bate em 443).
INGEST_API_PORT=8081

# Protege todo /ingest/* via header x-api-key. O processo nao sobe sem isto.
# O world-service precisa do MESMO valor em DEFAULT_LIVE_API_KEY.
INGEST_API_KEY=troque-por-um-secret-forte

# -------- Servidor RTMP/HLS (MediaMTX) --------
RTMP_APP_NAME=live
RTMP_INGEST_PORT=1935
RTMP_HTTP_PORT=8000
RTMP_MEDIA_ROOT=./media
MEDIAMTX_PATH=/usr/local/bin/mediamtx

# Host que entra nas URLs quando nenhum PUBLIC_* esta setado (default: localhost).
# Tambem e o endereco que o OBS usa enquanto PUBLIC_RTMP_BASE_URL ficar vazio.
RTMP_INGEST_HOST=192.168.15.9

# -------- URLs publicas: o que sai no payload da API --------
# Cada env governa uma URL. Default das tres: http://${RTMP_INGEST_HOST}:${porta}.
#
# Onde o OBS publica -> campo Server do OBS (campo rtmpUrl).
# PUBLIC_RTMP_BASE_URL=rtmp://app.seudominio.com:1935
#
# Origem do HLS (campo playbackUrl). Use https:// quando o player roda numa
# pagina https: http aqui vira mixed content e o browser bloqueia o .m3u8.
# PUBLIC_PLAYBACK_BASE_URL=https://live.seudominio.com
#
# Origem publica da API (campo watchUrl = ${PUBLIC_API_BASE_URL}/watch).
# PUBLIC_API_BASE_URL=https://ingest.seudominio.com
